# Required
CONTENT_DELIVERY_TOKEN="cms_d_your-delivery-token-here" # Obelism Content: reads published content.
CONTENT_ENVIRONMENT="production" # Obelism Content: the environment the tokens belong to.
CONTENT_SPACE_ID="space_your-space-id-here" # Obelism Content: a canvas token for any other space reads nothing.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-storefront-access-token-here"
NEXT_PUBLIC_SHOPIFY_SHOP_ID="123456789"

# Optional
# CONTENT_MANAGEMENT_TOKEN="cms_m_your-management-token-here" # `content model plan|apply` and `content init`; never deployed.
# CONTENT_WEBHOOK_SECRET="your-content-webhook-secret-here" # Set to refresh pages when content is published; POST /api/webhooks/content.
# CUSTOMER_ACCOUNT_SESSION_SECRET="your-session-secret-here"
# DEBUG_SHOPIFY="1" # Log structured Shopify API operation timings.
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID="123456789"
# REVALIDATE_SECRET="your-revalidate-secret-here" # Set to refresh content Shopify sends no webhook for, such as pages, policies, and menus; send it as a Bearer token to POST /api/revalidate.
# SHOPIFY_ADMIN_CLIENT_ID="0123456789abcdef0123456789abcdef" # Seed scripts only: a Dev Dashboard app installed on the store with write_products and write_publications.
# SHOPIFY_ADMIN_CLIENT_SECRET="shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # Seed scripts only; exchanged for a 24-hour Admin API token.
# SHOPIFY_API_VERSION="2026-10" # Override the Storefront API version, which defaults to the version Hydrogen targets.
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID="shp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_SECRET="your-customer-account-client-secret-here" # Required when auth.isEnabled is true.
# SHOPIFY_HEADLESS_PUBLICATION="Obelism Headless" # Seed scripts only: the Headless storefront the prints are published to.
# SHOPIFY_WEBHOOK_SECRET="your-shopify-webhook-secret-here"
